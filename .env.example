# Copy to BOTH `.env` (Node tooling) and `.dev.vars` (what `astro dev` reads via
# the Cloudflare adapter). Both are gitignored — never commit real values.
#
#   cp .env.example .env
#   cp .env.example .dev.vars
#
# Local stack: run `npx supabase start`, then take these from `npx supabase status`.
# Cloud project: Supabase dashboard → Settings → API (and run `npm run db:push`
# before using the app, or path creation answers 500).

# Local default: http://127.0.0.1:54321
SUPABASE_URL=<supabase project url>

# The `anon` public key — never the service_role key.
SUPABASE_KEY=<supabase anon key>
